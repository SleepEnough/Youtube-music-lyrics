{
    "manifest_version": 3,

    "name": "YTM Lyrics",
    "version": "0.1.0",

    "description": "YouTube Music 本機同步歌詞外掛",

    "action": {
        "default_title": "YTM Lyrics"
    },

    "host_permissions": [
            "https://music.youtube.com/*",
            "https://lrclib.net/*"
    ],

    "options_page": "settings.html",

    "permissions": [
        "storage"
    ],
    
    "background": {
        "service_worker": "background.js"
    },


    "content_scripts": [
        {
            "matches": [
                "https://music.youtube.com/*"
            ],
            "js": [
                "player-time.js"
            ],
            "world": "MAIN",
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://music.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}